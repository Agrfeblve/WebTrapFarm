# WebTrapFarm benchmark database
WEBTRAP_DB_HOST=127.0.0.1
WEBTRAP_DB_PORT=3306
WEBTRAP_DB_USER=agentguard
WEBTRAP_DB_PASSWORD=change-me
WEBTRAP_DB_NAME=benchmark

# Skyvern runner
SKYVERN_API_BASE=http://127.0.0.1:8000/v1
SKYVERN_API_KEY=
SKYVERN_ACTIVE_MODEL=qwen3-vl-235b-a22b-instruct
# SKYVERN_ARTIFACTS_ROOT=/absolute/path/to/artifacts

# Skyvern service model (OpenAI-compatible Qwen example)
ENABLE_OPENAI_COMPATIBLE=true
LLM_KEY=OPENAI_COMPATIBLE
OPENAI_COMPATIBLE_MODEL_KEY=OPENAI_COMPATIBLE
OPENAI_COMPATIBLE_MODEL_NAME=qwen3-vl-235b-a22b-instruct
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_SUPPORTS_VISION=true

ENV=local
LOG_LEVEL=INFO
MAX_STEPS_PER_RUN=50
ENABLE_LOG_ARTIFACTS=true
